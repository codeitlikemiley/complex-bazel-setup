load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

VERSION = "0.1.0"

rust_library(
    name = "corex_lib",
    # A glob, not a hardcoded src/lib.rs: with one file listed, the first
    # `mod helpers;` compiles under cargo and fails under Bazel with E0583.
    srcs = glob(["src/**/*.rs"]),
    crate_name = "corex",
    edition = "2024",
    # Without these, rules_rust bakes CARGO_PKG_NAME = the TARGET name
    # ("corex_lib") and CARGO_PKG_VERSION = "0.0.0" into the crate, so anything
    # reporting its own version -- /version handlers, telemetry, User-Agent --
    # disagrees with cargo.
    version = VERSION,
    rustc_env = {"CARGO_PKG_NAME": "corex"},
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
)

# No `deps` on a test that sets `crate`: rules_rust unions the rule's deps with
# the parent crate's (rust.bzl: depset(deps, transitive = [crate.deps])), so
# passing all_crate_deps(normal_dev = True) here only ever ADDS. corex has no
# [dev-dependencies] at all, so it was a no-op copied from the guide.
rust_test(
    name = "corex_tests",
    crate = ":corex_lib",
    size = "small",
    version = VERSION,
    rustc_env = {"CARGO_PKG_NAME": "corex"},
)

rust_doc_test(
    name = "corex_doc_test",
    crate = ":corex_lib",
    size = "small",
)
