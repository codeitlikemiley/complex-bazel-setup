# Bazel configuration for complex-bazel-setup.
#
#   Bazel version      -> .bazelversion
#   Rust toolchain     -> MODULE.bazel (rust.toolchain) + rust-toolchain.toml
#   Personal overrides -> .bazelrc.user (gitignored, imported at the bottom)

# ---------- correctness ----------
# An empty glob is a typo or a moved file, not an empty list. On by default in
# Bazel 8; pinned here so it survives a version change.
build --incompatible_disallow_empty_glob

# ---------- build profiles ----------
# Bazel's default compilation mode (fastbuild) is opt-level 0 with NO debug
# info, while `cargo build` gives you -C debuginfo=2. Without this, a backtrace
# out of `bazel run //server:server_bin` has bare addresses and a debugger has
# nothing to attach to -- one of the ways the two build systems disagreed.
build --compilation_mode=dbg
build:release --compilation_mode=opt
build:release --strip=always

# ---------- rules_rust ----------
# Verified against all 17 targets with rules_rust 0.63.0 / Bazel 8.7.0.
build --@rules_rust//rust/settings:pipelined_compilation=True

# ---------- caching ----------
build --disk_cache=~/.cache/bazel-disk
build --repository_cache=~/.cache/bazel-repo

# ---------- tests ----------
test --test_output=errors
test --build_tests_only

# ---------- lint ----------
# `bazel build --config=lint //...` runs rustfmt and clippy as aspects over the
# whole graph. Deferred in the toolchain-pinning change because clippy.toml and
# rustfmt.toml did not exist yet and the root package exported nothing.
build:lint --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect,@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:lint --output_groups=+rustfmt_checks,+clippy_checks
build:lint --@rules_rust//rust/settings:clippy_flags=-Dwarnings
build:lint --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build:lint --@rules_rust//rust/settings:rustfmt.toml=//:rustfmt.toml

# ---------- coverage ----------
# rules_rust ships llvm-tools with every toolchain >= 1.45.0 (repositories.bzl),
# so `bazel coverage //...` needs nothing beyond the pinned toolchain.
coverage --combined_report=lcov
coverage --instrumentation_filter=^//corex[:/],^//server[:/],^//combos[:/]

# ---------- CI ----------
build:ci --announce_rc --verbose_failures --keep_going
test:ci --flaky_test_attempts=1
# Surfaces targets whose declared size does not match how long they actually
# run. Every test in this repo is currently MODERATE and finishes in ~0.1s;
# they want size = "small". CI-only so local runs stay quiet.
test:ci --test_verbose_timeout_warnings
# Fail on a stale MODULE.bazel.lock instead of silently re-resolving. CI applies
# this on top of --config=ci once the lock exists; the `lockfile` job in
# .github/workflows/ci.yml regenerates and commits it whenever it drifts.
#
# Kept as its own config rather than folded into --config=ci because it is a
# hard error when the lock is missing, and because it is useful locally on its
# own: `bazel build --config=locked //...` answers "is my lock current?"
# without the rest of the CI flags.
#
# A lock generated against a local file:// registry mirror is NOT valid here --
# Bazel records no registryFileHashes for those, so the real registry treats it
# as out of date. It has to come from a machine (or a CI runner) that can reach
# bcr.bazel.build.
common:locked --lockfile_mode=error

try-import %workspace%/.bazelrc.user
