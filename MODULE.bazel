# MODULE.bazel
# Bring in Rust rules
bazel_dep(name = "rules_rust", version = "0.73.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

###############################################################################
## Rust toolchain
###############################################################################
#
# Without this block, `toolchains = root.tags.toolchain or rules_rust.tags.toolchain`
# (rules_rust rust/extensions.bzl:116 @0.73.0) falls back to rules_rust's OWN
# toolchain tag, which is still `rust.toolchain(edition = "2021")` at its
# MODULE.bazel:48. Every target here was compiled as edition 2021 while every
# Cargo.toml said 2024, and by whatever DEFAULT_RUST_VERSION that rules_rust
# release happened to carry -- 1.86.0 on 0.63.0, 1.97.1 on 0.73.0. Registering
# our own is what stops a rules_rust bump from silently changing the compiler.
#
# `versions` MUST stay in sync with rust-toolchain.toml -- that file is the
# cargo half of the same pin. If they drift, the two build systems are back to
# using different compilers on the same source.

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.94.1"],
    # No sha256s block: rules_rust 0.73.0 ships hashes for 1.94.1 in
    # rust/private/known_shas.bzl, and load_arbitrary_tool prefers an explicit
    # sha256s entry but falls back to those. It is needed only when the pinned
    # Rust version is NEWER than the rules_rust release knows about -- which was
    # the case on 0.63.0, whose known_shas stopped well before 1.94.1 and which
    # therefore downloaded the toolchain unverified. If you pin ahead of
    # rules_rust again, regenerate one with
    #     python3 tools/pin_rust_toolchain.py <version>
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

###############################################################################
## C/C++ toolchain
###############################################################################
#
# Without this, Bazel autodetects whatever cc happens to be on the machine. On
# the GitHub runners that is gcc driving ld.gold, which makes rustc emit
# "the gold linker is deprecated and has known bugs with Rust" on every link,
# and it means the 25 build scripts and 2 `links` crates in the dependency graph
# compile against a host toolchain nobody pinned.

bazel_dep(name = "toolchains_llvm", version = "1.8.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "20.1.3")
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

###############################################################################
## Third-party crates
###############################################################################

# Use crate_universe extension
crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)

# ONE repo for the whole workspace. Previously this was three -- combos_crates,
# corex_crates and server_crates -- which duplicated six crates (serde,
# serde_derive, syn, quote, proc-macro2, unicode-ident) and let the three
# lockfiles drift apart unnoticed (proc-macro2 was already 1.0.96 vs 1.0.97 and
# syn 2.0.104 vs 2.0.105). More importantly it meant server_bin linked two
# distinct serde rlibs, so no corex type could cross into server.
#
# Note: all_crate_deps() never emits workspace members -- cargo-bazel's
# deps_map template skips them explicitly -- so first-party edges such as
# //corex:corex_lib stay as hand-written Bazel labels in the BUILD files.
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//corex:Cargo.toml",
        "//server:Cargo.toml",
        "//combos/backend:Cargo.toml",
        "//combos/frontend:Cargo.toml",
    ],
)
use_repo(crate, "crates")
