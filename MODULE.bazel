###############################################################################
## Third-party crates
###############################################################################

# Use crate_universe extension
crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)

# ONE repo for the whole workspace. Previously this was three -- combos_crates,
# corex_crates and server_crates -- which duplicated six crates (serde,
# serde_derive, syn, quote, proc-macro2, unicode-ident) and let the three
# lockfiles drift apart unnoticed (proc-macro2 was already 1.0.96 vs 1.0.97 and
# syn 2.0.104 vs 2.0.105). More importantly it meant server_bin linked two
# distinct serde rlibs, so no corex type could cross into server.
#
# Note: all_crate_deps() never emits workspace members -- cargo-bazel's
# deps_map template skips them explicitly -- so first-party edges such as
# //corex:corex_lib stay as hand-written Bazel labels in the BUILD files.
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//corex:Cargo.toml",
        "//server:Cargo.toml",
        "//combos/backend:Cargo.toml",
        "//combos/frontend:Cargo.toml",
    ],
)
use_repo(crate, "crates")
