load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "frontend_bin",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "frontend",
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {"CARGO_PKG_NAME": "frontend"},
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

# No rust_test target: src/main.rs has nothing to assert yet. The previous one
# wrapped vacuous tests and reported PASSED regardless of the code.
