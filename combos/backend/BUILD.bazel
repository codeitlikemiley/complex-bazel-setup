load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "backend_bin",
    srcs = ["src/main.rs"],
    deps = all_crate_deps(normal = True),
    edition = "2024",
)

# No rust_test target: src/main.rs has no tests at all, so the previous
# backend_tests wrapped an empty binary and reported "0 tests ... ok" forever.
