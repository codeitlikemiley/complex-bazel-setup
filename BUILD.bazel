load("@buildifier_prebuilt//:rules.bzl", "buildifier", "buildifier_test")

# Source files in a package are private by default, so the label_flags in
# @rules_rust//rust/settings (a different package) cannot see //:clippy.toml or
# //:rustfmt.toml unless they are exported. Without this, `--config=lint` fails
# with "target '//:clippy.toml' is not visible from target
# '@@rules_rust//rust/settings:clippy.toml'".
exports_files([
    "clippy.toml",
    "rustfmt.toml",
    # buildifier_test's `workspace` attr needs this visible from the
    # buildifier_prebuilt package, same visibility rule as the settings above.
    "MODULE.bazel",
])

# `bazel run //:buildifier` formats and fixes every Starlark file in the repo.
buildifier(
    name = "buildifier",
    exclude_patterns = ["./.git/*"],
    lint_mode = "fix",
    mode = "fix",
)

# `bazel test //:buildifier_test` checks without modifying. Passing `workspace`
# makes it walk subpackages -- a plain srcs glob in the root package would only
# ever see the root BUILD.bazel, missing corex/, server/ and combos/.
buildifier_test(
    name = "buildifier_test",
    size = "small",
    exclude_patterns = ["./.git/*"],
    lint_mode = "warn",
    mode = "diff",
    no_sandbox = True,
    workspace = "//:MODULE.bazel",
)
